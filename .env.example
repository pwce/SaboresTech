# ==========================================================================
# Copia este archivo a ".env" (en la misma carpeta) y ajusta lo necesario
# antes de levantar el stack con: docker compose up -d --build
#
#   cp .env.example .env
# ==========================================================================

# IP o dominio del servidor donde va a correr todo el stack.
# El navegador del cliente usará esta dirección para hablar con el backend,
# así que debe ser una IP/host alcanzable desde afuera del servidor
# (ej: 192.168.1.50, la IP pública, o el nombre de dominio).
# Si vas a probar todo en tu propio computador, deja "localhost".
PUBLIC_HOST=localhost

# Puertos que se exponen en el host (el computador/servidor donde corre Docker)
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Credenciales de la base de datos (se usan tanto para el contenedor de
# Postgres como para la conexión del backend)
DATABASE=SaboresTech
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Seguridad de la API (cámbialas por valores propios en un ambiente real)
JWT_SECRET=cambia_esta_clave_super_secreta
COOKIE_KEY=cambia_esta_otra_clave_secreta
